<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent_deep</item>
        <item name="android:colorControlActivated">@color/accent_deep</item>
    </style>

    <style name="NeoMain">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/bagel_fat_one</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/ink</item>
        <item name="neoOffset">5dp</item>
    </style>

    <style name="NeoChip">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/ink</item>
        <item name="neoFill">@color/surface</item>
        <item name="neoOffset">3dp</item>
        <item name="neoRadius">14dp</item>
    </style>
</resources>
